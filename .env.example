# ---- Database (Hostinger MySQL — unchanged, accessed remotely) ----
DB_HOST=srv706.hstgr.io
DB_NAME=u932966089_hr_payroll_db
DB_USER=u932966089_hrsoftwareuk
DB_PASSWORD=your_database_password
DB_PORT=3306

# ---- Auth ----
# Generate a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret

# ---- Email (Gmail SMTP app password) ----
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# ---- Cron ----
# Any long random string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>"
# when the scheduled expiry check runs.
CRON_SECRET=your_cron_secret

# ---- Optional ----
# Leave unset on Vercel — the frontend calls /api same-origin automatically.
# Set only if the API is hosted elsewhere.
# VITE_API_URL=
